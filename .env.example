# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://dev:dev@localhost:5433/contractor_website_builder

# ============================================================
# REDIS / BULLMQ
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# GOOGLE OAUTH (User Sign-in)
# ============================================================
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ============================================================
# GOOGLE SERVICE ACCOUNT (Backend API calls: GSC, GA, GTM)
# ============================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=contractor-builder@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ============================================================
# GOOGLE BUSINESS PROFILE API
# ============================================================
GBP_API_KEY=AIzaSy...

# ============================================================
# GOOGLE ADS API (Keyword Planner)
# ============================================================
GOOGLE_ADS_DEVELOPER_TOKEN=xxxxxxxxxxxx
GOOGLE_ADS_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
GOOGLE_ADS_REFRESH_TOKEN=1//xxxxxxxxxx
GOOGLE_ADS_CUSTOMER_ID=123-456-7890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=123-456-7890

# ============================================================
# SMTP (Gmail App Passwords)
# ============================================================
SMTP_EMAIL=ads@contractingempire.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ============================================================
# EXTERNAL APIS (Maps, PageSpeed, Bright Data, SerpAPI)
# ============================================================
GOOGLE_MAPS_API_KEY=AIzaSy...
GOOGLE_PAGESPEED_API_KEY=AIzaSy...
BRIGHT_DATA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SERPAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================================
# AI / LLM PROVIDERS
# ============================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
ANTHROPIC_MODEL=claude-fable-20260801

OPENAI_API_KEY=sk-xxxxxxxxxxxx
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

GEMINI_API_KEY=AIzaSy...
GEMINI_LIVE_MODEL=gemini-2.5-live

# ============================================================
# CLOUDFLARE R2 (Object Storage)
# ============================================================
R2_ACCOUNT_ID=xxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxx
R2_BUCKET_NAME=contractor-website-builder-assets
R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://assets.yourproduct.com

# ============================================================
# STRIPE (Production Only)
# ============================================================
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_SUBSCRIPTION_PRICE_ID=price_xxxxxxxxxxxx
BYPASS_BILLING=true

# ============================================================
# VERCEL (Site Deployment)
# ============================================================
VERCEL_API_TOKEN=xxxxxxxxxxxx
VERCEL_TEAM_ID=team_xxxxxxxxxxxx

# ============================================================
# SESSION / JWT
# ============================================================
JWT_SECRET=xxxxxxxxxxxx-generate-a-strong-random-string
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ============================================================
# RATE LIMITING / SECURITY
# ============================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
