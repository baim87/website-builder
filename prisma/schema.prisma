generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  name              String?
  googleId          String?           @unique
  gmailRefreshToken String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  payments          Payment[]
  projects          Project[]
  subscription      Subscription?
  skillInvocations  SkillInvocation[]
}

model Project {
  id                     String                   @id @default(uuid())
  userId                 String
  name                   String
  status                 String                   @default("draft")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  assets                 Asset[]
  businessContext        BusinessContext?
  chatMessages           ChatMessage[]
  domain                 Domain?
  locationKeywordMetrics LocationKeywordMetrics[]
  pages                  Page[]
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectAssets          ProjectAsset[]
  siteAnalytics          SiteAnalytics?
  skillInvocations       SkillInvocation[]
  websiteData            WebsiteData?
  serviceKeywordMetrics  ServiceKeywordMetrics[]
  leads                  Lead[]
}

model BusinessContext {
  id                   String   @id @default(uuid())
  projectId            String   @unique
  businessName         String?
  contactPerson        String?
  businessAddress      String?
  phone                String?
  email                String?
  hours                Json?
  gbpData              Json?
  trade                String?
  location             String?
  targetAudience       String?
  services             Json?
  competitors          Json?
  rawText              String?
  serviceAreas         Json?
  brandIdentityInputs  Json?
  brandVoicePreference String?
  usps                 Json?
  interviewMetadata    Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  radius               Int?
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WebsiteData {
  id               String    @id @default(uuid())
  projectId        String    @unique
  designTokens     Json?
  seoMetadata      Json?
  sitemapXml       String?
  robotsTxt        String?
  jsonLdSchemas    Json?
  internalLinkMap  Json?
  generationStatus String    @default("pending")
  lastGeneratedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  customComponents Json?
  serviceRanking   Json?
  seasonalConfig   Json?
  qcReport         Json?
  qcStatus         String?   @default("standby")
  generationJobId  String?
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SiteAnalytics {
  id                    String   @id @default(uuid())
  projectId             String   @unique
  ga4PropertyId         String?
  ga4MeasurementId      String?
  gtmContainerId        String?
  gscUrl                String?
  gscSiteUrl            String?
  gscVerificationStatus String?
  leadNotificationEmail String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Asset {
  id           String   @id @default(uuid())
  projectId    String
  url          String
  type         String
  purpose      String?
  convertedUrl String?
  fallbackUrl  String?
  mimeType     String?
  source       String   @default("upload")
  sortOrder    Int      @default(0)
  section      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectAsset {
  id               String   @id @default(uuid())
  projectId        String
  type             String
  prompt           String?
  originalUrl      String?
  webpUrl          String?
  status           String   @default("pending")
  cost             Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  referenceAssetId String?
  metadata         Json?
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id                 String   @id @default(uuid())
  projectId          String
  role               String
  content            String
  metadata           Json?
  voiceTranscript    Boolean  @default(false)
  skillInvocationRef String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SkillInvocation {
  id               String   @id @default(uuid())
  projectId        String
  skillType        String
  inputHash        String
  model            String
  tokens           Int?
  latencyMs        Int?
  outputHash       String?
  status           String
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  completionTokens Int?
  cost             Float?
  metadata         Json?
  promptTokens     Int?
  outputData       Json?

  traceId String?
  userId  String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([traceId])
  @@index([userId])
  @@index([projectId])
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  stripeCustomerId     String
  stripeSubscriptionId String
  status               String
  planId               String
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(uuid())
  userId          String
  stripePaymentId String   @unique
  amount          Int
  currency        String
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Domain {
  id         String   @id @default(uuid())
  projectId  String   @unique
  domainName String   @unique
  provider   String?
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Page {
  id             String   @id @default(uuid())
  projectId      String
  slug           String
  content        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  componentCode  Json?
  customCSS      String?
  keywordTarget  Json?
  seoMeta        Json?
  status         String   @default("pending")
  contentVersion Int      @default(1)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model Lead {
  id        String   @id @default(uuid())
  projectId String
  name      String?
  email     String?
  phone     String?
  message   String?
  source    String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model LocationKeywordMetrics {
  id           String   @id @default(uuid())
  projectId    String
  city         String
  state        String?
  service      String
  keyword      String
  searchVolume Int
  difficulty   Float?
  cpc          Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, city, service])
}

model GlobalKeywordCache {
  id      String  @id @default(uuid())
  city    String
  state   String?
  trade   String? // Optional: The broad trade category (e.g. "Decking")
  service String // The specific service (e.g. "Deck Building")
  keyword String // The actual search query (e.g. "deck building omaha")

  // Google Ads Metrics
  searchVolume   Int
  monthlyVolumes Json?
  competition    String?
  cpc            Float?
  geoScope       String  @default("national_proxy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A city and a specific service should be globally unique
  @@unique([city, service])
}

model ServiceKeywordMetrics {
  id               String   @id @default(uuid())
  projectId        String
  city             String
  service          String
  keyword          String // Best transactional keyword for this (city, service)
  searchVolume     Int
  monthlyVolumes   Json? // 12-month breakdown from Google Ads
  competition      String? // LOW / MEDIUM / HIGH
  cpc              Float?
  rank             Int // 1 = main, 2 = secondary, etc.
  geoScope         String   @default("city") // "city" | "county" | "ai_inferred"
  avgTicketPrice   Float? // Future: from user interview
  revenuePotential Float? // Future: volume × ticket
  userOverrideRank Int? // Future: manual user preference
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, city, service])
}
