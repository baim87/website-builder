{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/setup.ts"],
  "moduleNameMapper": {
    "^@octokit/rest$": "<rootDir>/mock-octokit.ts"
  }
}
